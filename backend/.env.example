# ===========================================
# HAPPY FEET - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Never commit .env to version control
# ===========================================

# -------------------------------------------
# Application
# -------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Frontend URL (for CORS, cookies, etc.)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# -------------------------------------------
# Database (MongoDB)
# -------------------------------------------
MONGODB_URI=mongodb://admin:secret@localhost:27017/happy_feet?authSource=admin
MONGODB_DB_NAME=happy_feet

# -------------------------------------------
# Cache (Redis)
# -------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_TTL_DEFAULT=300
REDIS_TTL_PRODUCTS=600
REDIS_TTL_CATEGORIES=3600

# -------------------------------------------
# Authentication
# -------------------------------------------
# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Argon2
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Email verification
EMAIL_VERIFICATION_EXPIRY=24h

# Password reset
PASSWORD_RESET_EXPIRY=1h

# Session
SESSION_ROTATION_ENABLED=true
SESSION_MAX_AGE=604800000

# -------------------------------------------
# OAuth Providers
# -------------------------------------------
# Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Apple
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key
APPLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/apple/callback

# -------------------------------------------
# M-Pesa Daraja API
# -------------------------------------------
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=http://localhost:4000/api/v1/payments/mpesa/callback
MPESA_TIMEOUT_URL=http://localhost:4000/api/v1/payments/mpesa/timeout
MPESA_RESULT_URL=http://localhost:4000/api/v1/payments/mpesa/result

# -------------------------------------------
# Cloudflare R2 (Object Storage)
# -------------------------------------------
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=happy-feet-media
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# -------------------------------------------
# Email (SMTP)
# -------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@happyfeet.co.ke
EMAIL_FROM_NAME=Happy Feet

# -------------------------------------------
# WhatsApp Business API
# -------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token
WHATSAPP_WEBHOOK_URL=http://localhost:4000/api/v1/webhooks/whatsapp

# -------------------------------------------
# Security
# -------------------------------------------
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# CORS
CORS_ORIGIN=http://localhost:3000

# Helmet CSP
CSP_REPORT_URI=

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true

# -------------------------------------------
# Feature Flags
# -------------------------------------------
FEATURE_AI_ASSISTANT=false
FEATURE_3D_VIEWER=false
FEATURE_WHATSAPP_INTEGRATION=false